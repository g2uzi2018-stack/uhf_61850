						<DOI name="AnIn3">
							<DAI name="d">
								<Val>峰值相位</Val>
							</DAI>
						</DOI>
						<DOI name="AnIn4">
							<DAI name="d">
								<Val>背景噪声</Val>
							</DAI>
						</DOI>
					</LN>
					<LN lnType="UHFPD12PDMON.LPHD1" lnClass="LPHD" inst="1">
						<DOI name="PhyHealth">
							<DAI name="d">
								<Val>物理设备健康状态</Val>
							</DAI>
