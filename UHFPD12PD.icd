	<IED name="UHFPD12PD">
		<Services>
			<DynAssociation />
			<GetDirectory />
			<GetDataObjectDefinition />
			<DataObjectDirectory />
			<GetDataSetValue />
			<SetDataSetValue />
			<DataSetDirectory />
			<ConfDataSet max="1" modify="false" />
			<DynDataSet max="42" />
			<ReadWrite />
			<ConfReportControl max="2" />
			<GetCBValues />
			<ReportSettings rptID="Dyn" optFields="Dyn" bufTime="Dyn" trgOps="Dyn" intgPd="Dyn" />
			<ConfLNs fixPrefix="true" fixLnInst="true" />
			<GOOSE max="0" />
			<GSSE max="0" />
			<FileHandling />
		</Services>
		<AccessPoint name="P1">
			<Server>
				<Authentication none="true" />
				<LDevice inst="MON">
					<LN0 lnType="UHFPD12PDMON.LLN0" lnClass="LLN0" inst="">
						<DataSet name="DSMeasurements" desc="局部放电遥测数据集">
							<FCDA ldInst="MON" prefix="" lnClass="GGIO" lnInst="1" doName="AnIn1" daName="mag.f" fc="MX" />
							<FCDA ldInst="MON" prefix="" lnClass="GGIO" lnInst="1" doName="IntIn1" daName="stVal" fc="ST" />
							<FCDA ldInst="MON" prefix="" lnClass="GGIO" lnInst="1" doName="AnIn2" daName="mag.f" fc="MX" />
							<FCDA ldInst="MON" prefix="" lnClass="GGIO" lnInst="1" doName="AnIn3" daName="mag.f" fc="MX" />
							<FCDA ldInst="MON" prefix="" lnClass="GGIO" lnInst="1" doName="AnIn4" daName="mag.f" fc="MX" />
							<FCDA ldInst="MON" prefix="" lnClass="SPDC" lnInst="1" doName="PaDschAlm" daName="stVal" fc="ST" />
						</DataSet>
						<DataSet name="DSState" desc="局部放电遥信数据集">
							<FCDA ldInst="MON" prefix="" lnClass="SPDC" lnInst="1" doName="PaDschAlm" daName="stVal" fc="ST" />
						</DataSet>
						<ReportControl name="RPMeasurements" desc="局放遥测数据报告控制块" rptID="RPMeasurements" buffered="false" bufTime="0" datSet="DSMeasurements" intgPd="60000" confRev="1">
							<TrgOps dchg="true" qchg="true" dupd="false" period="true" />
							<OptFields seqNum="true" timeStamp="true" dataSet="true" reasonCode="true" dataRef="true" entryID="false" configRef="false" />
							<RptEnabled />
						</ReportControl>
						<ReportControl name="RPState" desc="局放遥信数据报告控制块" rptID="RPState" buffered="true" bufTime="4000" datSet="DSState" intgPd="60000" confRev="1">
							<TrgOps dchg="true" qchg="true" dupd="false" period="true" />
							<OptFields seqNum="true" timeStamp="true" dataSet="true" reasonCode="true" dataRef="true" entryID="false" configRef="false" />
							<RptEnabled />
						</ReportControl>
						<DOI name="Health">
							<DAI name="d">
								<Val>设备健康状态</Val>
							</DAI>
						</DOI>
					</LN0>
					<LN lnType="UHFPD12PDMON.GGIO1" lnClass="GGIO" inst="1">
						<DOI name="AnIn1">
							<DAI name="d">
								<Val>放电均值</Val>
							</DAI>
						</DOI>
						<DOI name="IntIn1">
							<DAI name="d">
								<Val>脉冲次数</Val>
							</DAI>
