					<LN lnType="UHFPD12PDMON.SPDC1" lnClass="SPDC" inst="1">
						<DOI name="UhfPaDsch">
							<DAI name="d">
								<Val>标准 UHF 局放峰值</Val>
							</DAI>
						</DOI>
						<DOI name="PaDschAlm">
							<DAI name="d">
								<Val>局部放电告警</Val>
							</DAI>
						</DOI>
					</LN>
				</LDevice>
			</Server>
		</AccessPoint>
	</IED>
