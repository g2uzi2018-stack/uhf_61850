[Unit]
Description=UHF gateway release health guard
After=uhf-gateway.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/lib/uhf-gateway/release-guard.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/uhf-gateway /var/lib/uhf-gateway
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
