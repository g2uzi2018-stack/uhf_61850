[Unit]
Description=UHF 61850 integrated monitoring gateway
Wants=network-online.target uhf-network-recovery.service
Requires=uhf-privileged.service
After=network-online.target uhf-network-recovery.service uhf-privileged.service
ConditionFileIsExecutable=/opt/uhf-gateway/current/bin/uhf-gatewayd
ConditionPathExists=/etc/uhf-gateway/v3-runtime.env
ConditionPathExists=/etc/uhf-gateway/v3-device-id
ConditionPathExists=/etc/uhf-gateway/v3-manufacturer-key
ConditionPathExists=/etc/uhf-gateway/v3-activation-code
StartLimitIntervalSec=120s
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=uhfgateway
Group=uhfgateway
SupplementaryGroups=dialout
WorkingDirectory=/opt/uhf-gateway/current
EnvironmentFile=/etc/uhf-gateway/v3-runtime.env
ExecStart=/opt/uhf-gateway/current/bin/uhf-gatewayd --web --v3 --web-root /opt/uhf-gateway/current/web --state-dir /var/lib/uhf-gateway --config /var/lib/uhf-gateway/config.json --data-dir /var/lib/uhf-gateway/data --privileged-socket /run/uhf-gateway/privileged.sock --v3-pd-device ${UHF_V3_PD_DEVICE} --v3-current-device ${UHF_V3_CURRENT_DEVICE} --v3-temperature-device ${UHF_V3_TEMPERATURE_DEVICE} --v3-device-id-file /etc/uhf-gateway/v3-device-id --v3-activation-key-file /etc/uhf-gateway/v3-manufacturer-key --v3-activation-code-file /etc/uhf-gateway/v3-activation-code
Restart=on-failure
RestartSec=2s
WatchdogSec=20s
MemoryMax=128M
TasksMax=64
LimitNOFILE=256
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
DevicePolicy=closed
DeviceAllow=/dev/null rw
DeviceAllow=/dev/urandom r
DeviceAllow=/dev/random r
DeviceAllow=/dev/ttyS1 rw
DeviceAllow=/dev/ttyS2 rw
DeviceAllow=/dev/ttyS3 rw
DeviceAllow=/dev/ttyS4 rw
ReadWritePaths=/var/lib/uhf-gateway /run/uhf-gateway
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
