# Copy this file outside the release tree to /etc/uhf-gateway/v3-runtime.env
# and replace every value with a target-specific, verified device path.
# The packaged installer validates that all three variables are present, but
# it cannot determine the correct target-board tty names.
UHF_V3_PD_DEVICE=/dev/REPLACE_PD_SERIAL
UHF_V3_CURRENT_DEVICE=/dev/REPLACE_CURRENT_SERIAL
UHF_V3_TEMPERATURE_DEVICE=/dev/REPLACE_TEMPERATURE_SERIAL
